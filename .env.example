# ─────────────────────────────────────────────────────────────────────────────
# KoraScore — environment variables (names only; never commit real values)
# Copy to .env.local for local development, and add the same names in
# Vercel → Project → Settings → Environment Variables (Production + Preview).
# Everything except NEXT_PUBLIC_* is server-side only and never shipped to the
# browser.
# ─────────────────────────────────────────────────────────────────────────────

# --- primary data provider (required for live data) -------------------------
# football-data.org token; sent as X-Auth-Token from the server only.
FOOTBALL_DATA_API_TOKEN=

# --- optional extra providers ------------------------------------------------
# api-football (API-SPORTS). The adapter auto-enables when this is present.
# Adds Egyptian Premier League (league 233) and a second fallback tier.
API_FOOTBALL_KEY=
# TheSportsDB: the public key "3" works with documented per-endpoint caps;
# a Patreon supporter key raises those caps without code changes.
THESPORTSDB_API_KEY=3
# Set to "false" to disable the ESPN public scoreboard fallback entirely.
ESPN_PROVIDER_ENABLED=true

# --- open, public-domain historical dataset (no key) ------------------------
# openfootball (football.json + world) powers the "past seasons" league tab,
# including Egyptian Premier League seasons. CC0 / public domain.
# Set to "false" to switch the dataset off completely.
OPENFOOTBALL_ENABLED=true
# HTTP timeout for the (larger) dataset files, milliseconds.
OPENFOOTBALL_TIMEOUT_MS=10000

# --- news headlines (OPT-IN, licensing is the operator's decision) -----------
# Comma-separated "Label|FeedURL" list. Leave EMPTY to keep the feature off:
# without it, no external news request is ever made and /news stays noindex.
# Example (check each publisher's terms first, e.g. BBC Sport RSS requires a
# visible credit and permission for business use):
# NEWS_FEEDS=BBC Sport|https://feeds.bbci.co.uk/sport/football/rss.xml
NEWS_FEEDS=
# Directory presets: comma-separated ids from src/lib/newsSources.ts, a curated
# set whose feed URL + link hosts + display policy were verified with a real
# request (bbc-sport-football, kingfut, ...). This is the recommended way: you
# enable only what you have the right to display, and nothing else is fetched.
# Leave empty to keep the whole feature inert.
NEWS_PRESETS=
NEWS_TIMEOUT_MS=8000

# --- HTTP behaviour / resilience --------------------------------------------
PROVIDER_TIMEOUT_MS=8000
PROVIDER_TEXT_TIMEOUT_MS=12000
PROVIDER_MAX_RETRIES=1
PROVIDER_MAX_TEXT_BYTES=4000000
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_MS=300000

# --- site / SEO --------------------------------------------------------------
# Absolute production URL — used for canonical, hreflang, OG and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_TIMEZONE=Africa/Cairo

# --- background jobs ---------------------------------------------------------
# Protects /api/cron/warm; Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=

# --- internal diagnostics ----------------------------------------------------
# Optional dedicated token for /api/admin/diagnostics. When empty the route
# falls back to CRON_SECRET; when neither is set the route answers 404 so it can
# never be probed on an unconfigured deployment.
DIAGNOSTICS_TOKEN=

# --- official broadcast centre (isolated, opt-in) -----------------------------
# Existing /ar/live and /en/live remain scores. /live redirects to /{locale}/watch.
# Change this build-time flag and redeploy to enable/disable the whole module.
NEXT_PUBLIC_LIVE_ENABLED=false
# Empty = bundled public/live/catalog.json, no runtime filesystem writes.
# Optional Supabase read-only anon client. Apply docs/live/supabase.sql first.
NEXT_PUBLIC_LIVE_SUPABASE_URL=
NEXT_PUBLIC_LIVE_SUPABASE_ANON_KEY=
# Server-only service role: reports/admin/automation. NEVER use NEXT_PUBLIC_*.
LIVE_SUPABASE_SERVICE_ROLE_KEY=
# Random >=32-character salt for anonymous, HMAC-hashed report identities.
LIVE_REPORT_SALT=
# Vercel identity headers are trusted automatically. On OTHER hosts only enable
# after the reverse proxy overwrites x-real-ip AND strips/overwrites x-forwarded-for.
# Otherwise all requests use a conservative shared identity, not client claims.
LIVE_TRUST_PROXY_HEADERS=false
# Random >=24-character password; admin is 404 unless durable storage is set up.
LIVE_ADMIN_PASSWORD=
# Publicly displayed contact address, required before launching to real users.
LIVE_RIGHTS_EMAIL=
# Automation only: GitHub Actions secrets, NOT public browser variables.
YOUTUBE_API_KEY=
SCOREBAT_API_TOKEN=
